            "text": "SELECT COL1 FROM TBL1 UNION SELECT COL1 FROM TBL2"
          }
        ],
        "イ": [
          {
            "type": "sql",
            "text": "SELECT DISTINCT a.COL1 FROM TBL1 a WHERE EXISTS (SELECT 1 FROM TBL2 b WHERE a.COL1 = b.COL1)"
